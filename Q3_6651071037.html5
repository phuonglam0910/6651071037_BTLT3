<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Trang giới thiệu sản phẩm của Điện tử ABC">
    <title>Điện tử ABC</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f0f6ff;
            color: #333;
        }

        /* KHUNG TRANG */
        .container {
            width: 900px;
            max-width: 95%;
            margin: 25px auto 0;
            background-color: white;
            box-shadow: 0 3px 12px #bbb;
        }

        /* HEADER */
        header.shop-header {
            height: 75px;
            background: linear-gradient(
                90deg,
                #087cf0,
                #32c5d2,
                #e91e63
            );

            display: flex;
            align-items: center;
            padding: 8px 25px;
            color: white;
        }

        .shop-header img {
            width: 60px;
            height: 60px;
            background-color: white;
            border-radius: 8px;
            padding: 3px;
            margin-right: 15px;
        }

        .shop-header h1 {
            margin: 0;
            font-size: 25px;
        }

        /* NỘI DUNG */
        main {
            padding: 10px 35px 20px;
        }

        /* TIÊU ĐỀ */
        .title {
            color: #087cf0;
            font-size: 21px;
            margin: 5px 0 15px;
            border-left: 5px solid #e91e63;
            padding-left: 10px;
        }

        /* KHU VỰC SẢN PHẨM */
        .product-area {
            display: grid;
            grid-template-columns: 210px 1fr 150px;
            gap: 15px;
            align-items: start;
        }

        /* ẢNH */
        .product-image {
            text-align: center;
        }

        .product-image img {
            width: 200px;
            height: 200px;
            object-fit: cover;
            border: 2px solid #087cf0;
            border-radius: 7px;
            padding: 5px;
            background-color: white;
        }

        /* THÔNG TIN */
        .product-info h2 {
            font-size: 17px;
            color: #075fc0;
            margin: 0 0 8px;
        }

        .product-info p {
            font-size: 12px;
            line-height: 1.5;
            text-align: justify;
            margin: 5px 0 10px;
        }

        /* BẢNG */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        caption {
            font-size: 11px;
            color: #e91e63;
            font-weight: bold;
            margin-bottom: 3px;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 5px 7px;
        }

        thead {
            background-color: #087cf0;
            color: white;
        }

        thead th {
            text-align: center;
        }

        tbody th {
            background-color: #eef6ff;
            color: #075fc0;
            text-align: left;
        }

        tbody tr:nth-child(even) td {
            background-color: #fff0f6;
        }

        tbody tr:hover td,
        tbody tr:hover th {
            background-color: #ffe0eb;
        }

        /* CHÍNH SÁCH */
        .policy {
            border: 1px solid #ccc;
            border-top: 4px solid #e91e63;
            border-radius: 7px;
            padding: 10px;
            background-color: #fff;
        }

        .policy h3 {
            font-size: 12px;
            color: #ff1744;
            margin: 0 0 8px;
        }

        .policy ul {
            padding-left: 15px;
            margin: 0;
        }

        .policy li {
            font-size: 10px;
            margin-bottom: 7px;
        }

        .policy li::marker {
            color: #087cf0;
        }

        /* SẢN PHẨM TƯƠNG TỰ */
        .similar-title {
            color: #087cf0;
            font-size: 16px;
            margin: 12px 0 7px;
            border-bottom: 2px solid #e91e63;
            padding-bottom: 4px;
        }

        .similar-products {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            width: 65%;
        }

        .product-card {
            border: 1px solid #ccc;
            border-radius: 6px;
            padding: 7px;
            display: flex;
            align-items: center;
            gap: 7px;
            background-color: white;
            transition: 0.3s;
        }

        .product-card:hover {
            border-color: #e91e63;
            box-shadow: 0 3px 8px #ccc;
            transform: translateY(-3px);
        }

        .product-card img {
            width: 45px;
            height: 45px;
            object-fit: cover;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .product-card h4 {
            margin: 0;
            font-size: 10px;
            color: #075fc0;
        }

        .product-card p {
            margin: 4px 0 0;
            font-size: 9px;
            color: #ff1744;
            font-weight: bold;
        }

        /* FOOTER */
        footer.shop-footer {
            background: linear-gradient(
                90deg,
                #075fc0,
                #087cf0,
                #e91e63
            );

            color: white;
            padding: 10px 25px;
            font-size: 10px;
        }

        footer.shop-footer h4 {
            margin: 0 0 5px;
            font-size: 12px;
        }

        footer.shop-footer p {
            margin: 3px 0;
        }

        address {
            font-style: normal;
            line-height: 1.5;
        }

        /* RESPONSIVE */
        @media (max-width: 750px) {

            .product-area {
                grid-template-columns: 1fr;
            }

            .product-image img {
                display: block;
                margin: auto;
            }

            .policy {
                width: 100%;
            }

            .similar-products {
                width: 100%;
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- HEADER SHOP -->
        <header class="shop-header">

            <img src="logo.png"
                 alt="Logo Điện tử ABC"
                 width="60"
                 height="60">

            <h1>Điện tử ABC</h1>

        </header>


        <main>

            <!-- TIÊU ĐỀ -->
            <h2 class="title">Thông tin sản phẩm</h2>


            <!-- KHU VỰC SẢN PHẨM -->
            <div class="product-area">

                <!-- HÌNH ẢNH -->
                <div class="product-image">

                    <img src="https://hanhmobile.com/wp-content/uploads/2024/12/Samsung-S24-Ultra-xam-anh-2.png"
                         alt="Samsung Galaxy S24 Ultra"
                         width="200"
                         height="200">

                </div>


                <!-- THÔNG TIN + BẢNG -->
                <div class="product-info">

                    <h2>Samsung Galaxy S24 Ultra</h2>

                    <p>
                        Samsung Galaxy S24 Ultra là dòng điện thoại cao cấp
                        với thiết kế hiện đại, hiệu năng mạnh mẽ và hệ thống
                        camera chất lượng cao. Sản phẩm phù hợp cho học tập,
                        làm việc, giải trí và chụp ảnh.
                    </p>


                    <table>

                        <caption>
                            Thông số kỹ thuật
                        </caption>

                        <thead>
                            <tr>
                                <th scope="col">Thông số</th>
                                <th scope="col">Chi tiết</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <th scope="row">Màn hình</th>
                                <td>6.8 inch Dynamic AMOLED 2X</td>
                            </tr>

                            <tr>
                                <th scope="row">Camera</th>
                                <td>Camera chính 200MP</td>
                            </tr>

                            <tr>
                                <th scope="row">Pin</th>
                                <td>5000 mAh</td>
                            </tr>

                            <tr>
                                <th scope="row">RAM</th>
                                <td>12 GB</td>
                            </tr>

                            <tr>
                                <th scope="row">Bộ nhớ</th>
                                <td>256 GB</td>
                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- CHÍNH SÁCH -->
                <aside class="policy">

                    <h3>Chính sách mua hàng</h3>

                    <ul>
                        <li>Bảo hành 12 tháng</li>
                        <li>Đổi trả 7 ngày</li>
                        <li>Miễn phí ship</li>
                    </ul>

                </aside>

            </div>


            <!-- SẢN PHẨM TƯƠNG TỰ -->
            <h3 class="similar-title">
                Sản phẩm tương tự
            </h3>

            <div class="similar-products">

                <div class="product-card">

                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT3kv080ovdtKFZwbViYKxk76vvnl0ntPTd06BE0emw8Z9Vgv4d4KzJ2Bg&s=10"
                         alt="iPhone 15 Pro Max"
                         width="45"
                         height="45">

                    <div>
                        <h4>iPhone 15 Pro Max</h4>
                        <p>29.990.000 VNĐ</p>
                    </div>

                </div>


                <div class="product-card">

                    <img src="https://viostore.vn/wp-content/uploads/2023/10/3-6.png"
                         alt="Xiaomi 14 Pro"
                         width="45"
                         height="45">

                    <div>
                        <h4>Xiaomi 14 Pro</h4>
                        <p>16.990.000 VNĐ</p>
                    </div>

                </div>


                <div class="product-card">

                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRqZsTbrAzJEQafNRq419XfwidJeVeFNesT4adoIOmBO7aAeBIrJd-zaBg&s=10"
                         alt="Galaxy Z Fold5"
                         width="45"
                         height="45">

                    <div>
                        <h4>Galaxy Z Fold5</h4>
                        <p>29.990.000 VNĐ</p>
                    </div>

                </div>

            </div>

        </main>


        <!-- FOOTER -->
        <footer class="shop-footer">

            <h4>Liên hệ</h4>

            <address>
                Địa chỉ: 123 Đường ABC, Quận 1, TP. Hồ Chí Minh<br>
                Điện thoại: 0123 456 789 |
                Email: dientuabc@example.com |
                Website: www.dientuabc.com
            </address>

            <p>
                © 2024 Điện tử ABC. All rights reserved.
            </p>

        </footer>

    </div>

</body>
</html>
